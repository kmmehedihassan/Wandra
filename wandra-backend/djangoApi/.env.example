# Copy to .env for local development.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Production (Railway) — set these in the service's variables:
# DEBUG=False
# SECRET_KEY=<long random string>
# ALLOWED_HOSTS=your-backend.up.railway.app
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://your-backend.up.railway.app   (defaults to ALLOWED_HOSTS)
# SECURE_HSTS_SECONDS=3600
# SECURE_SSL_REDIRECT=False

# Email for password reset (free: https://www.brevo.com — see README)
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=Wandra <you@example.com>
# FRONTEND_URL=https://your-frontend.example.com
# Or SMTP instead of Brevo:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Payments (free sandbox: https://developer.sslcommerz.com/registration/)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=True

# Optional tuning
# AUTH_THROTTLE_RATE=10/min
# UPLOAD_THROTTLE_RATE=30/hour
# PASSWORD_RESET_THROTTLE_RATE=5/hour
# PASSWORD_RESET_TIMEOUT=3600
# TIME_ZONE=Asia/Dhaka
